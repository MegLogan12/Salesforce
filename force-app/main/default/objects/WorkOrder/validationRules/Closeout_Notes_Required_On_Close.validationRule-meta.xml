<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closeout_Notes_Required_On_Close</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Profile.Name = &quot;System Administrator&quot;),
    (ISPICKVAL(Status, &quot;Closed&quot;) &amp;&amp; (Is_Finish_Job__c || Is_Warranty__c) &amp;&amp; ISBLANK(Closeout_Notes__c))
)</errorConditionFormula>
    <errorDisplayField>Closeout_Notes__c</errorDisplayField>
    <errorMessage>Closeout notes are required before closing a Finish Job or Warranty work order.</errorMessage>
</ValidationRule>
