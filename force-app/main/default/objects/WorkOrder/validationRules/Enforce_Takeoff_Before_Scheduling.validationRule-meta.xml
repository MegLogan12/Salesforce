<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Enforce_Takeoff_Before_Scheduling</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, &quot;Ready to Schedule&quot;) &amp;&amp; 
(ISNULL(Sod_Square_Footage__c) || Sod_Square_Footage__c &lt;= 0)</errorConditionFormula>
    <errorMessage>You cannot move to &apos;Ready to Schedule&apos; until the Sod Square Footage has been recorded during Takeoff</errorMessage>
</ValidationRule>
