    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Pending Review</fullName>
                <default>true</default>
                <label>Pending Review</label>
            </value>
            <value>
                <fullName>Manager Approved</fullName>
                <default>false</default>
                <label>Manager Approved</label>
            </value>
            <value>
                <fullName>Manager Rejected</fullName>
                <default>false</default>
                <label>Manager Rejected</label>
            </value>
            <value>
                <fullName>Manual Override</fullName>
                <default>false</default>
                <label>Manual Override</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
