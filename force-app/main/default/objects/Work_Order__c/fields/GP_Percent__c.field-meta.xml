<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>GP_Percent__c</fullName>
    <description>Gross profit percent. Work Order tier spec Section 7.4. The * 100 matches the org Percent-field convention (store 38 to show 38%).</description>
    <formula>IF( Total_Revenue__c = 0, 0, ( Total_Revenue__c - Total_Cost__c ) / Total_Revenue__c * 100 )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>GP Percent</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
