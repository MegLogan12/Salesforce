<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Builder_Paid_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c, &quot;Paid by Builder&quot;),
ISBLANK(Builder_Paid_Date__c)
)</errorConditionFormula>
    <errorMessage>Builder Paid Date is required when Voucher Status is Paid by Builder.</errorMessage>
</ValidationRule>
