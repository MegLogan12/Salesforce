<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Aqua_Pickup_Due__c</fullName>
    <formula>AND(ISPICKVAL(Lot_Status__c, &quot;Closed&quot;), OR(Aqua_Installed__c, Aqua_Add_On__c &gt; 0), NOT(Aqua_Pickup_Created__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Aqua Pickup Due</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
