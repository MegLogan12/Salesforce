<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_To_Renewal__c</fullName>
    <description>Days until contract renewal. Negative means overdue. Drives renewal-due chip and report filter. Spec Section 5.3.</description>
    <externalId>false</externalId>
    <formula>IF( ISBLANK(Contract_Renewal_Date__c), null, Contract_Renewal_Date__c - TODAY() )</formula>
    <label>Days To Renewal</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
