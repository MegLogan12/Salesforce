<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Adjusted_Revenue__c</fullName>
    <description>Recognized revenue after customer-facing credits. Total_Revenue__c minus Customer_Revenue_Adjustment__c. Drives division revenue and GP rollups.</description>
    <formula>NULLVALUE(Total_Revenue__c, 0) - NULLVALUE(Customer_Revenue_Adjustment__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Adjusted Revenue</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
