<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage">
            <property name="cardTitle" type="String" label="Card Title" default="Email History"/>
            <property
                name="cardSubtitle"
                type="String"
                label="Card Subtitle"
                default="Related customer emails, logged messages, and follow-up communications"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>