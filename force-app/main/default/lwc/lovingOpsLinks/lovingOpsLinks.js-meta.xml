<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__UtilityBar</target>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__UtilityBar">
            <property name="label"       type="String" default="Ops Links"                    label="Button Label"/>
            <property name="wexUrl"      type="String" default="https://online.wexfleet.com"  label="WEX Fleet GPS Portal URL"/>
            <property name="weatherUrl"  type="String" default="https://forecast.weather.gov/" label="Weather Forecast URL"/>
            <property name="ripplingUrl" type="String" default="https://app.rippling.com"     label="Rippling URL"/>
            <property name="mapsUrl"     type="String" default="https://www.google.com/maps"  label="Google Maps URL"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
