<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>MC Featured Banner</masterLabel>
    <description>Top banner for Measuring Cup app highlighting weekly callout.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="headline" type="String" default="This Week" label="Headline"/>
            <property name="subhead" type="String" default="" label="Subheadline"/>
            <property name="ctaLabel" type="String" default="" label="CTA Label"/>
            <property name="ctaUrl" type="String" default="" label="CTA URL"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>