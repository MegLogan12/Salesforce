<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>LOVING Field Manager App User</label>
    <description>Grants a Field Manager user access to the LOVING Field Manager web/iOS app. Required objects: WorkOrder (read/edit), ServiceAppointment (read), WorkOrderLineItem (read), QI_Inspection__c (read/create/edit), QI_Line_Item__c (read/create), Finish_Job__c (read/create/edit), Aqua_Inventory__c (read), Schedule_Issue__c (read/create/edit), ContentVersion (create), ContentDocumentLink (read/create), Task (create). User must also have FM__c set to their User ID on the WorkOrders they manage.</description>

    <!-- Standard FSL objects -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>WorkOrder</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
