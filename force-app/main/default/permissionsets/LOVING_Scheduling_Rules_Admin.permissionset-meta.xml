<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Allows the holder to add, edit, remove, and toggle scheduling Decision Rules from the Field Services Console. Without this set, the Decision Rules tab is read-only.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>LOVING Scheduling Rules Admin</label>
    <customPermissions>
        <enabled>true</enabled>
        <name>LOVING_Edit_Scheduling_Rules</name>
    </customPermissions>
    <objectPermissions>
        <object>Decision_Rule__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>true</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Rule_Type__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Favors__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Weight_Pct__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Setting__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Applies_To__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Active__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Rule__c.Sort_Order__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
</PermissionSet>
