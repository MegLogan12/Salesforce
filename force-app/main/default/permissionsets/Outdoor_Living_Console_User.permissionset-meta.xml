<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants Apex class access and field-level security for the Outdoor Living Console — Opportunity record pages, workspace, and engagement health.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Outdoor Living Console User</label>
    <classAccesses>
        <apexClass>ODLOpportunityRecordController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ODLOpportunityWorkspaceController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ODLInboundResponseService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ODLOpportunityCloseController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <field>Opportunity.Last_Customer_Response_Date__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Design_Fee_Status__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Design_Fee_Paid_Date__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Deposit_Due__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Deposit_Paid__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Opportunity.Deposit_Paid_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
