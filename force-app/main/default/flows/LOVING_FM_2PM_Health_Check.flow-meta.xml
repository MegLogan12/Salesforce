<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM submits the daily 2 PM job health check. Green = on track for completion today. Red = will not complete today, creates Schedule Issue for scheduling team. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fJobHealthValue</name>
        <dataType>String</dataType>
        <expression>IF({!Input_HealthStatus} = &quot;Green - On Track&quot;, &quot;Green&quot;, &quot;Red&quot;)</expression>
    </formulas>
    <formulas>
        <name>fSI_Summary</name>
        <dataType>String</dataType>
        <expression>&quot;Red 2PM Check — will not complete today. &quot; &amp; {!Input_Notes}</expression>
    </formulas>
    <formulas>
        <name>fTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Red 2PM health check — reschedule needed: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <interviewLabel>LOVING FM 2PM Health Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM 2PM Health Check</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <decisions>
        <name>Check_Is_Red</name>
        <label>Is Job Red?</label>
        <locationX>264</locationX>
        <locationY>396</locationY>
        <defaultConnector>
            <targetReference>Update_WorkOrder_Health</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Green — on track</defaultConnectorLabel>
        <rules>
            <name>Is_Red</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Input_HealthStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Red - Will Not Complete Today</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Red_Issue</targetReference>
            </connector>
            <label>Red — will not complete</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Red_Issue</name>
        <label>Create Red Schedule Issue</label>
        <locationX>440</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Create_Red_Task</targetReference>
        </connector>
        <inputAssignments>
            <field>Standard_Work_Order__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Issue_Type__c</field>
            <value>
                <stringValue>Will Not Complete Today</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Summary__c</field>
            <value>
                <elementReference>fSI_Summary</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_Manager__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Required_Action__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Schedule_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Red_Task</name>
        <label>Notify Scheduling — Red</label>
        <locationX>440</locationX>
        <locationY>612</locationY>
        <connector>
            <targetReference>Update_WorkOrder_Health</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>fSI_Summary</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_HealthCheck</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_WorkOrder_Health</name>
        <label>Save Health Check</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Health_Check_Status__c</field>
            <value>
                <elementReference>Input_HealthStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job_Health__c</field>
            <value>
                <elementReference>fJobHealthValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Health_Check_FM_Notes__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Afternoon_Check_Complete__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Health_Check_Date__c</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Health_Check_Responded_At__c</field>
            <value>
                <elementReference>fNow</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Health_Check_At__c</field>
            <value>
                <elementReference>fNow</elementReference>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <screens>
        <name>Screen_HealthCheck</name>
        <label>2 PM Health Check</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Check_Is_Red</targetReference>
        </connector>
        <fields>
            <name>Display_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;Submit the 2 PM job health check. If Red, a Schedule Issue will be created immediately so the scheduling team can plan a return date.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_HealthStatus</name>
            <choiceReferences>Choice_Green</choiceReferences>
            <choiceReferences>Choice_Red</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Job Status at 2 PM</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_Notes</name>
            <fieldText>Notes (progress, what's done, what remains, any blockers)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>Health Check Submitted</label>
        <locationX>176</locationX>
        <locationY>828</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Health check submitted — {!Input_HealthStatus}.&lt;/b&gt; Your 2 PM check has been recorded for Work Order {!Get_WorkOrder.WorkOrderNumber}.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Green</name>
        <choiceText>Green — on track to complete today</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Green - On Track</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Red</name>
        <choiceText>Red — will NOT complete today (reschedule needed)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Red - Will Not Complete Today</stringValue>
        </value>
    </choices>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
