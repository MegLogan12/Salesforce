<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Check_No_Existing_DQC</name>
        <label>Check No Existing DQC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>DQC Already Exists</defaultConnectorLabel>
        <rules>
            <name>No_DQC_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_DQC</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_DQC_Record</targetReference>
            </connector>
            <label>No DQC Yet</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Prior_Status_And_Scope</name>
        <label>Check Prior Status and Scope</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Action</defaultConnectorLabel>
        <rules>
            <name>Status_Changed_To_In_Progress_With_Scope</name>
            <conditionLogic>(1 AND 2) AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sod_Square_Footage__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Mulch_CY__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_DQC</targetReference>
            </connector>
            <label>Status Changed to In Progress with Scope</label>
        </rules>
    </decisions>
    <description>Auto-creates a Delivery_Quality_Check__c when WorkOrder Status__c changes to In Progress and the WO has sod or mulch in scope. Snapshots sod square footage, roll coverage, and species from WorkOrder at creation time. Only creates one DQC per WO — will not create duplicates. INACTIVE — activate only after PKG-DQC-PARENT-01 complete and Meg approves.</description>
    <environments>Default</environments>
    <formulas>
        <name>fMulchIncluded</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Mulch_CY__c} &gt; 0</expression>
    </formulas>
    <formulas>
        <name>fSodIncluded</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Sod_Square_Footage__c} &gt; 0</expression>
    </formulas>
    <interviewLabel>LOVING Delivery QC Submit {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Delivery QC Submit</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_DQC_Record</name>
        <label>Create DQC Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Expected_Sod_Roll_Coverage__c</field>
            <value>
                <elementReference>$Record.Community_Sod_Roll_Coverage__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Expected_Sod_Species__c</field>
            <value>
                <elementReference>$Record.Sod_Species__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Expected_Sod_Square_Footage__c</field>
            <value>
                <elementReference>$Record.Sod_Square_Footage__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Mulch_Included__c</field>
            <value>
                <elementReference>vMulchIncluded</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Performed_By__c</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sod_Included__c</field>
            <value>
                <elementReference>vSodIncluded</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Supplier__c</field>
            <value>
                <elementReference>$Record.Supplier__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Work_Order__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Delivery_Quality_Check__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_DQC</name>
        <label>Get Existing DQC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_No_Existing_DQC</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Work_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Delivery_Quality_Check__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Prior_Status_And_Scope</targetReference>
        </connector>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>vMulchIncluded</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>fMulchIncluded</elementReference>
        </value>
    </variables>
    <variables>
        <name>vSodIncluded</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <elementReference>fSodIncluded</elementReference>
        </value>
    </variables>
</Flow>
