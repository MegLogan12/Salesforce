<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM submits the Quality Inspection result for a completed work order. Records QI result, score, and notes; sets QI_Status to Submitted. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;QI submitted for review: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber} &amp; &quot; — &quot; &amp; {!Input_QIResult}</expression>
    </formulas>
    <interviewLabel>LOVING FM Complete QI {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Complete QI</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Task</name>
        <label>Notify QI Reviewer</label>
        <locationX>176</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_QI</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>QI_Status__c</queriedFields>
        <queriedFields>QI_Due_Date__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_WorkOrder_QI</name>
        <label>Save QI to Work Order</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Create_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>QI_Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>QI_Result__c</field>
            <value>
                <elementReference>Input_QIResult</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>QI_Score__c</field>
            <value>
                <elementReference>Input_Score</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>QI_FM__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>QI_Completed_Date__c</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>QI_Complete__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <screens>
        <name>Screen_QI</name>
        <label>Quality Inspection</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_WorkOrder_QI</targetReference>
        </connector>
        <fields>
            <name>Display_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;Submit the Quality Inspection result. Selecting &lt;b&gt;Red — Rework Required&lt;/b&gt; will flag the work order for FM review before closeout.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_QIResult</name>
            <choiceReferences>Choice_Excellent</choiceReferences>
            <choiceReferences>Choice_Acceptable</choiceReferences>
            <choiceReferences>Choice_Red</choiceReferences>
            <dataType>String</dataType>
            <fieldText>QI Result</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_Score</name>
            <dataType>Number</dataType>
            <fieldText>QI Score (0–100)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Notes</name>
            <fieldText>QI Notes (failed items, corrective action required, photos taken)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>QI Submitted</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;QI submitted.&lt;/b&gt; Result &lt;b&gt;{!Input_QIResult}&lt;/b&gt; has been saved to Work Order {!Get_WorkOrder.WorkOrderNumber}. The QI reviewer has been notified.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Excellent</name>
        <choiceText>Excellent — all items pass, exceptional quality</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Excellent</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Acceptable</name>
        <choiceText>Acceptable — all items pass, meets standard</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Acceptable</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Red</name>
        <choiceText>Red — rework required before closeout</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Red — Rework Required</stringValue>
        </value>
    </choices>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
