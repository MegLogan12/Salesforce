<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>When a Takeoff__c Status changes to Approved, create a Locate_Request__c in Not Submitted. All takeoff scopes require 811. Idempotent — skips if one already exists for this takeoff.</description>
    <label>LOVING Takeoff — Create Locate Request</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <decisions>
        <name>Check_No_Existing_Locate</name>
        <label>No Existing Locate?</label>
        <locationX>264</locationX>
        <locationY>300</locationY>
        <defaultConnectorLabel>Already exists — skip</defaultConnectorLabel>
        <rules>
            <name>No_Locate_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Locate.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Create_Locate_Request</targetReference></connector>
            <label>No locate yet — create one</label>
        </rules>
    </decisions>

    <recordCreates>
        <name>Create_Locate_Request</name>
        <label>Create Locate Request</label>
        <locationX>264</locationX>
        <locationY>450</locationY>
        <inputAssignments>
            <field>Takeoff__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Lot__c</field>
            <value><elementReference>$Record.Lot__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Not Submitted</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Assigned_To__c</field>
            <value><elementReference>$Record.FM_Assignment__c</elementReference></value>
        </inputAssignments>
        <object>Locate_Request__c</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>

    <recordLookups>
        <name>Get_Existing_Locate</name>
        <label>Get Existing Locate Request</label>
        <locationX>264</locationX>
        <locationY>150</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Check_No_Existing_Locate</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Takeoff__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Locate_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <start>
        <locationX>264</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Get_Existing_Locate</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Approved</stringValue></value>
        </filters>
        <object>Takeoff__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
