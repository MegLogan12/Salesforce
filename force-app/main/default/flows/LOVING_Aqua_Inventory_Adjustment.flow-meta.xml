<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Requires_Billing_Review</name>
        <label>Requires Billing Review</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>No Billing Required</defaultConnectorLabel>
        <rules>
            <name>Billing_Reason_A_or_C</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Aqua_Inventory_Reason_Code__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>(A)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Aqua_Inventory_Reason_Code__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>(C)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Billing_Task</targetReference>
            </connector>
            <label>Reason A or C</label>
        </rules>
    </decisions>
    <description>When an Aqua Inventory Adjustment record is created with Reason A or C (billing reasons), create a billing review task for the FM.</description>
    <interviewLabel>LOVING Aqua Inventory Adjustment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Aqua Inventory Adjustment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Billing_Task</name>
        <label>Create Billing Review Task</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Inventory adjustment with billing reason code created. Review and process billing workflow for missing or additional coverage material.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Aqua Billing Review — Inventory Adjustment</stringValue>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Requires_Billing_Review</targetReference>
        </connector>
        <object>Aqua_Inventory_Adjustment__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
