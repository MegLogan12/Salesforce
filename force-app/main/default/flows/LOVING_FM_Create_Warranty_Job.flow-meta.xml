<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM creates a Warranty work order from an existing work order when warranty-covered rework is required. Records warranty type, description, and links to the originating WO. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fWarranty_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;WARRANTY — &quot; &amp; {!Get_WorkOrder.WorkOrderNumber} &amp; &quot; — &quot; &amp; {!Get_WorkOrder.Subject}</expression>
    </formulas>
    <formulas>
        <name>fTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Schedule Warranty WO for: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <interviewLabel>LOVING FM Create Warranty Job {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Create Warranty Job</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Warranty_WO</name>
        <label>Create Warranty Work Order</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Create_Task</targetReference>
        </connector>
        <inputAssignments>
            <field>ParentWorkOrderId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fWarranty_Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>Get_WorkOrder.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Is_Warranty__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Input_Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Task</name>
        <label>Notify Customer Success</label>
        <locationX>176</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Input_Description</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Warranty</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Screen_Warranty</name>
        <label>Create Warranty Job</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Warranty_WO</targetReference>
        </connector>
        <fields>
            <name>Display_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;Create a Warranty work order for rework covered under the landscape warranty. The warranty WO will be linked to this work order.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_WarrantyType</name>
            <choiceReferences>Choice_Sod</choiceReferences>
            <choiceReferences>Choice_Plant</choiceReferences>
            <choiceReferences>Choice_Irrigation</choiceReferences>
            <choiceReferences>Choice_Drainage</choiceReferences>
            <choiceReferences>Choice_Hardscape</choiceReferences>
            <choiceReferences>Choice_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Warranty Type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_Description</name>
            <fieldText>Describe what needs to be repaired or replaced (be specific — scope, location, quantities if known)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>Warranty Job Created</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Warranty work order created.&lt;/b&gt; The warranty WO has been linked to {!Get_WorkOrder.WorkOrderNumber}. Customer Success has been notified to review and schedule.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Sod</name>
        <choiceText>Sod — dead, damaged, or insufficient coverage</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Sod</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Plant</name>
        <choiceText>Plant — dead, declining, or wrong species</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Plant</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Irrigation</name>
        <choiceText>Irrigation — head, zone, or leak issue</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Irrigation</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Drainage</name>
        <choiceText>Drainage — pooling, washout, or erosion</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Drainage</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Hardscape</name>
        <choiceText>Hardscape — settling, cracking, or failure</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Hardscape</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Other</name>
        <choiceText>Other (explain in description)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
