<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FSL Mobile Quick Action: Submit closeout for a Work Order. Captures confirmed quantities, photo count, and notes. Sets closeout fields and submitted date.</description>
    <interviewLabel>LOVING FSL Closeout {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FSL — Closeout</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>Flow</processType>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <formulas>
        <name>fToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>

    <screens>
        <name>Screen_Closeout</name>
        <label>Submit Closeout</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Update_WorkOrder</targetReference></connector>
        <fields>
            <name>disp_Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Confirm closeout quantities and submit.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Enter confirmed material counts from the job site.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>inp_ConfHoses</name>
            <dataType>Number</dataType>
            <fieldText>Confirmed Hoses</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>inp_ConfControllers</name>
            <dataType>Number</dataType>
            <fieldText>Confirmed Controllers</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>inp_ConfHeads</name>
            <dataType>Number</dataType>
            <fieldText>Confirmed Heads</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>inp_ConfValves</name>
            <dataType>Number</dataType>
            <fieldText>Confirmed Valves</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>inp_PhotosAttached</name>
            <dataType>Boolean</dataType>
            <fieldText>Photos Confirmed Attached?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>inp_CloseoutNotes</name>
            <fieldText>Closeout Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
    </screens>

    <recordUpdates>
        <name>Update_WorkOrder</name>
        <label>Update Work Order — Closeout</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Confirmed_Hoses__c</field>
            <value><elementReference>inp_ConfHoses</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Confirmed_Controllers__c</field>
            <value><elementReference>inp_ConfControllers</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Confirmed_Heads__c</field>
            <value><elementReference>inp_ConfHeads</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Confirmed_Valves__c</field>
            <value><elementReference>inp_ConfValves</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Photos_Attached__c</field>
            <value><elementReference>inp_PhotosAttached</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Notes__c</field>
            <value><elementReference>inp_CloseoutNotes</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Quantities_Confirmed__c</field>
            <value><booleanValue>true</booleanValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Submitted_Date__c</field>
            <value><elementReference>fToday</elementReference></value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Screen_Closeout</targetReference></connector>
    </start>
    <status>Active</status>
</Flow>
