<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Scheduled flow that runs every Monday morning. Queries all active Manager-DirectReport pairs and creates a 1:1 meeting record for the upcoming week if one does not already exist.</description>
    <interviewLabel>LOVING 1on1 Auto Generate Monday {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING 1on1 Auto Generate Monday</label>
    <loops>
        <name>Loop_Existing_1on1s</name>
        <label>Loop Existing 1on1 Records</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <collectionReference>Get_Existing_1on1s</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_1on1_Record</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_1on1_Record</name>
        <label>Create 1on1 Meeting Record</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>Loop_Existing_1on1s</targetReference>
        </connector>
        <inputAssignments>
            <field>Cadence__c</field>
            <value>
                <stringValue>Weekly</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Direct_Report__c</field>
            <value>
                <elementReference>Loop_Existing_1on1s.Direct_Report__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Manager__c</field>
            <value>
                <elementReference>Loop_Existing_1on1s.Manager__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Meeting_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </inputAssignments>
        <object>OneOnOne__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_1on1s</name>
        <label>Get Active 1on1 Pairs From Last Week</label>
        <locationX>176</locationX>
        <locationY>98</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Existing_1on1s</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Cadence__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Weekly</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OneOnOne__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_1on1s</targetReference>
        </connector>
        <schedule>
            <frequency>Weekly</frequency>
            <startDate>2026-05-04</startDate>
            <startTime>07:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
