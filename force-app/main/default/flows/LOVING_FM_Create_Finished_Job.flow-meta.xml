<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM creates a Finished Job child work order when a Production Install cannot be completed in the scheduled window. Records reason and notes; creates FJ WO linked to the parent. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fFJ_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;FJ — &quot; &amp; {!Get_WorkOrder.WorkOrderNumber} &amp; &quot; — &quot; &amp; {!Get_WorkOrder.Subject}</expression>
    </formulas>
    <formulas>
        <name>fTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Schedule Finished Job for: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <interviewLabel>LOVING FM Create Finished Job {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Create Finished Job</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_FJ_WorkOrder</name>
        <label>Create Finished Job WO</label>
        <locationX>176</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Create_Task</targetReference>
        </connector>
        <inputAssignments>
            <field>ParentWorkOrderId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fFJ_Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>Get_WorkOrder.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Is_Finished_Job__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Is_Finish_Job__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finish_Job_Reason__c</field>
            <value>
                <elementReference>Input_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finish_Job_Notes__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Task</name>
        <label>Notify Scheduling</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_FJ</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>WorkTypeId</queriedFields>
        <queriedFields>Lot__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Parent_WO</name>
        <label>Flag Parent WO Finish Job Required</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Create_FJ_WorkOrder</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Finish_Job_Required__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finish_Job_Reason__c</field>
            <value>
                <elementReference>Input_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Finish_Job_Notes__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <screens>
        <name>Screen_FJ</name>
        <label>Create Finished Job</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_Parent_WO</targetReference>
        </connector>
        <fields>
            <name>Display_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;Create a Finished Job work order for the remaining scope. The FJ will be linked to this work order and queued for scheduling.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_Reason</name>
            <choiceReferences>Choice_Time</choiceReferences>
            <choiceReferences>Choice_Material</choiceReferences>
            <choiceReferences>Choice_Equipment</choiceReferences>
            <choiceReferences>Choice_Scope</choiceReferences>
            <choiceReferences>Choice_Weather</choiceReferences>
            <choiceReferences>Choice_Access</choiceReferences>
            <choiceReferences>Choice_Crew</choiceReferences>
            <choiceReferences>Choice_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Why wasn't the job completed today?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_Notes</name>
            <fieldText>What still needs to be done? (remaining scope, quantities, location details)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>Finished Job Created</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Finished Job created.&lt;/b&gt; A new Finished Job work order has been linked to {!Get_WorkOrder.WorkOrderNumber}. The scheduling team has been notified to schedule the remaining scope.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Time</name>
        <choiceText>Ran out of time</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Ran Out of Time</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Material</name>
        <choiceText>Material short or incorrect</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Material Short</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Equipment</name>
        <choiceText>Equipment failure</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Equipment Failure</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Scope</name>
        <choiceText>Scope change</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Scope Change</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Weather</name>
        <choiceText>Weather</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Weather</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Access</name>
        <choiceText>Site access blocked</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Site Access Blocked</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Crew</name>
        <choiceText>Crew short</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Crew Short</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Other</name>
        <choiceText>Other (explain in notes)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
