<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM records field takeoff measurements from an active Work Order. Saves quantities, marks Takeoff_Status = Confirmed, creates Task for scheduling review. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fTakeoffTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Review FM takeoff: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <interviewLabel>LOVING FM Complete Takeoff {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Complete Takeoff</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Takeoff_Task</name>
        <label>Create Task for Scheduling</label>
        <locationX>176</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTakeoffTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Measurements</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>PO_Number__c</queriedFields>
        <queriedFields>PO_Amount__c</queriedFields>
        <queriedFields>Lot__c</queriedFields>
        <queriedFields>Takeoff_Sod_Sqft__c</queriedFields>
        <queriedFields>Takeoff_Trees_15G__c</queriedFields>
        <queriedFields>Takeoff_Trees_30G__c</queriedFields>
        <queriedFields>Takeoff_Trees_45G__c</queriedFields>
        <queriedFields>Takeoff_Shrubs_1G__c</queriedFields>
        <queriedFields>Takeoff_Shrubs_3G__c</queriedFields>
        <queriedFields>Takeoff_Shrubs_7G__c</queriedFields>
        <queriedFields>Takeoff_Lighting_Units__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_WorkOrder_Takeoff</name>
        <label>Save Takeoff to Work Order</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Create_Takeoff_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Takeoff_Sod_Sqft__c</field>
            <value>
                <elementReference>Input_Sod_Sqft</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Trees_15G__c</field>
            <value>
                <elementReference>Input_Trees_15G</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Trees_30G__c</field>
            <value>
                <elementReference>Input_Trees_30G</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Trees_45G__c</field>
            <value>
                <elementReference>Input_Trees_45G</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Shrubs_1G__c</field>
            <value>
                <elementReference>Input_Shrubs_1G</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Shrubs_3G__c</field>
            <value>
                <elementReference>Input_Shrubs_3G</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Shrubs_7G__c</field>
            <value>
                <elementReference>Input_Shrubs_7G</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Lighting_Units__c</field>
            <value>
                <elementReference>Input_Lighting</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Notes__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_FM__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Date__c</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Status__c</field>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Complete__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff_Completed__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <screens>
        <name>Screen_Measurements</name>
        <label>Takeoff Measurements</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_WorkOrder_Takeoff</targetReference>
        </connector>
        <fields>
            <name>Display_WO_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;&lt;b&gt;PO:&lt;/b&gt; {!Get_WorkOrder.PO_Number__c}&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;PO Amount:&lt;/b&gt; {!Get_WorkOrder.PO_Amount__c}&lt;/p&gt;
&lt;p&gt;Enter your field measurements. Values from the PO are shown for reference.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_Sod_Sqft</name>
            <dataType>Number</dataType>
            <fieldText>Sod (sq ft)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Trees_15G</name>
            <dataType>Number</dataType>
            <fieldText>Trees — 15 Gallon</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Trees_30G</name>
            <dataType>Number</dataType>
            <fieldText>Trees — 30 Gallon</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Trees_45G</name>
            <dataType>Number</dataType>
            <fieldText>Trees — 45 Gallon</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Shrubs_1G</name>
            <dataType>Number</dataType>
            <fieldText>Shrubs — 1 Gallon</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Shrubs_3G</name>
            <dataType>Number</dataType>
            <fieldText>Shrubs — 3 Gallon</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Shrubs_7G</name>
            <dataType>Number</dataType>
            <fieldText>Shrubs — 7 Gallon</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Lighting</name>
            <dataType>Number</dataType>
            <fieldText>Lighting Units</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Input_Notes</name>
            <fieldText>Takeoff Notes (variances, site conditions, PO discrepancies)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>Takeoff Submitted</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Takeoff submitted.&lt;/b&gt; Your measurements have been saved to Work Order {!Get_WorkOrder.WorkOrderNumber}.&lt;/p&gt;
&lt;p&gt;The scheduling team has been notified. If quantities show a variance from the PO, a Scheduling Manager will review before releasing to schedule.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
