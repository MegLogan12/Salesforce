<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Assign_ResourceAbsence_Fields</name>
        <label>Assign ResourceAbsence Fields</label>
        <locationX>176</locationX>
        <locationY>420</locationY>
        <assignmentItems>
            <assignToReference>var_ResourceAbsence.ResourceId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>var_ServiceResource.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_ResourceAbsence.Start</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_AbsenceStartDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_ResourceAbsence.End</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formula_AbsenceEndDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_ResourceAbsence.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Time Off</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>var_ResourceAbsence.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Rippling Time Off Sync</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_ResourceAbsence</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Decision_Existing_Absences</name>
        <label>Existing Absences Found?</label>
        <locationX>500</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Assign_ResourceAbsence_Fields</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No — Create New</defaultConnectorLabel>
        <rules>
            <name>Has_Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_ExistingAbsences</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_ResourceAbsences</targetReference>
            </connector>
            <label>Yes — Replace Existing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_SR_Found_Create</name>
        <label>ServiceResource Found?</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <defaultConnector>
            <targetReference>Log_No_SR_Issue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found — Log and Exit</defaultConnectorLabel>
        <rules>
            <name>SR_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_ServiceResource.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_ResourceAbsences</targetReference>
            </connector>
            <label>Found — Refresh Absence</label>
        </rules>
    </decisions>
    <description>Syncs Rippling_Time_Off__c rows to FSL ResourceAbsence using current source fields (Employee__c, Start_Date__c, End_Date__c). Refreshes absence idempotently on create/update and logs missing ServiceResource mapping to Schedule_Issue__c.</description>
    <formulas>
        <name>formula_AbsenceEndDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT(IF(ISBLANK({!$Record.End_Date__c}), {!$Record.Start_Date__c}, {!$Record.End_Date__c})) &amp; &quot; 23:59:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_AbsenceStartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TEXT({!$Record.Start_Date__c}) &amp; &quot; 00:00:00&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_LogNoSRMessage</name>
        <dataType>String</dataType>
        <expression>&quot;Rippling time off &quot; &amp; {!$Record.Id} &amp; &quot; approved for Employee &quot; &amp; {!$Record.Employee__c} &amp; &quot; but no active ServiceResource found. Create a ServiceResource in FSL for this employee to enable scheduling blocks.&quot;</expression>
    </formulas>
    <interviewLabel>LOVING Rippling ResourceAbsence Sync {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Rippling ResourceAbsence Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
