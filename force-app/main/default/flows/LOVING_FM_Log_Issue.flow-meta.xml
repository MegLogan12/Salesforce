    <description>Guided issue router for Field Managers. FM selects an issue type from 14 options; flow routes to the correct object (Schedule_Issue__c, Warranty_Record__c, child WorkOrder, UMB_Quote_Request__c, or Case). Launched as Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fSI_Summary</name>
        <dataType>String</dataType>
        <expression>{!Input_IssueType} &amp; &quot;: &quot; &amp; {!Input_Summary}</expression>
    </formulas>
    <formulas>
        <name>fSI_IssueTypeMapped</name>
        <dataType>String</dataType>
        <expression>IF({!Input_IssueType} = &quot;Missing Material&quot;, &quot;Missing Material&quot;,
IF({!Input_IssueType} = &quot;Safety&quot;, &quot;Safety Hazard&quot;,
IF({!Input_IssueType} = &quot;Drainage&quot;, &quot;Site Issue&quot;,
IF({!Input_IssueType} = &quot;Utility Conflict&quot;, &quot;Site Issue&quot;,
IF({!Input_IssueType} = &quot;Access&quot;, &quot;Site Issue&quot;,
IF({!Input_IssueType} = &quot;Crew Damage&quot;, &quot;Site Issue&quot;,
IF({!Input_IssueType} = &quot;Quantity Variance&quot;, &quot;Other&quot;,
IF({!Input_IssueType} = &quot;Builder Punch&quot;, &quot;Other&quot;,
&quot;Other&quot;))))))))</expression>
    </formulas>
    <formulas>
        <name>fFJ_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Finished Job — &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <formulas>
        <name>fCase_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Customer Complaint — &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <interviewLabel>LOVING FM Log Issue {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Log Issue</label>
