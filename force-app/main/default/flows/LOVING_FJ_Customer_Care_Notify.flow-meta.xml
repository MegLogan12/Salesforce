<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_CC_Notification</name>
        <label>Send Finished Job Notification to Customer Care</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <stringValue>0MLVu000000SiKfOAK</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Finished Job Flagged — Customer Care Action Required</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>$Record.Subject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varRecipientIds</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <description>Record-triggered flow on WorkOrder. Fires when FJ_Recommended__c becomes true. Sends immediate notification to Customer Care. Creates follow-up Task. Mandatory — Customer Care must always be notified when a lot is flagged as Finished Job. INACTIVE until Customer Care queue/user confirmed in org.</description>
    <environments>Default</environments>
    <interviewLabel>LOVING FJ Customer Care Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FJ Customer Care Notify</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_CC_Task</name>
        <label>Create Customer Care Follow-Up Task</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <connector>
            <targetReference>Assign_Recipient_Id</targetReference>
        </connector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>$Record.Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>FJ ALERT — Finished Job Flagged — Homeowner Walk-Through Required</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <assignments>
        <name>Assign_Recipient_Id</name>
        <label>Add Owner to Recipient Collection</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_CC_Notification</targetReference>
        </connector>
    </assignments>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Create_CC_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FJ_Recommended__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varRecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
