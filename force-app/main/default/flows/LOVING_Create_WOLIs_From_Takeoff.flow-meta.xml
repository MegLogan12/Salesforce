    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Check_Has_Approved_Takeoff</name>
        <label>Approved Builder Takeoff Found?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No approved Builder Takeoff found</defaultConnectorLabel>
        <rules>
            <name>Approved_Takeoff_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Approved_Takeoff.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Standard_WOLIs</targetReference>
            </connector>
            <label>Approved Builder Takeoff found</label>
        </rules>
    </decisions>
    <description>Home Builder path: after Purchase_Order__c is linked to the standard parent WorkOrder, resolve the approved Builder Takeoff by PO number and generate standard WorkOrderLineItems from approved Takeoff lines using LovingPoBackboneService.</description>
    <interviewLabel>LOVING Create WOLIs From Takeoff {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Create WOLIs From Takeoff</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
