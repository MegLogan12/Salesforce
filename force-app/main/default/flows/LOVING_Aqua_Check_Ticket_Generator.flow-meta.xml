<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <decisions>
        <name>Check_Lots_Found</name>
        <label>Any Active Lots</label>
        <locationX>176</locationX>
        <locationY>218</locationY>
        <defaultConnectorLabel>No Active Lots</defaultConnectorLabel>
        <rules>
            <name>Has_Active_Lots</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Aqua_Lots</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Lots</targetReference>
            </connector>
            <label>Has Active Lots</label>
        </rules>
    </decisions>
    <decisions>
        <name>No_Existing_Ticket</name>
        <label>No Existing Ticket for Today</label>
        <locationX>396</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Loop_Lots</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Ticket Already Exists</defaultConnectorLabel>
        <rules>
            <name>Should_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Check_Ticket</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Check_Ticket</targetReference>
            </connector>
            <label>No Ticket — Create</label>
        </rules>
    </decisions>
    <description>Runs daily at 6 AM UTC. Creates an Aqua_Check_Ticket__c for every active lot (Aqua_Installed__c = true, not closed) that does not already have an open check ticket for today.</description>
    <interviewLabel>LOVING Aqua Check Ticket Generator {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Aqua Check Ticket Generator</label>
    <loops>
        <name>Loop_Lots</name>
        <label>Loop Active Lots</label>
        <locationX>176</locationX>
        <locationY>338</locationY>
        <collectionReference>Get_Active_Aqua_Lots</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Existing_Check_Ticket</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Check_Ticket</name>
        <label>Create Aqua Check Ticket</label>
        <locationX>616</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>Loop_Lots</targetReference>
        </connector>
        <inputAssignments>
            <field>Community__c</field>
            <value>
                <elementReference>Loop_Lots.Community__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lot__c</field>
            <value>
                <elementReference>Loop_Lots.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Scheduled_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <object>Aqua_Check_Ticket__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Active_Aqua_Lots</name>
        <label>Get Active Aqua Lots</label>
        <locationX>176</locationX>
        <locationY>98</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Lots_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Aqua_Installed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Closing_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lot__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Check_Ticket</name>
        <label>Get Existing Check Ticket Today</label>
        <locationX>396</locationX>
        <locationY>338</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>No_Existing_Ticket</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lot__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Lots.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Scheduled_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Aqua_Check_Ticket__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Active_Aqua_Lots</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-05-01</startDate>
            <startTime>10:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
