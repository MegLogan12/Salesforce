    <decisions>
        <name>Lot_Changed</name>
        <label>Did Lot Change?</label>
        <locationX>176</locationX>
        <locationY>60</locationY>
        <defaultConnectorLabel>Lot Unchanged — skip</defaultConnectorLabel>
        <rules>
            <name>Yes_Lot_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lot__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Lot__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lot_Record</targetReference>
            </connector>
            <label>Yes — Lot changed</label>
        </rules>
    </decisions>
    <description>Before-save: derives Community, Community Package, Builder Division, Division Account, and Parent Account on Builder_PO__c from the associated Lot. Enforces full hierarchy integrity. Phase 2 update: adds Division_Account__c and Parent_Account__c derivation via Lot → Community → Account chain. Rule: derivation only fires when Lot__c changes (or on create) — does not overwrite manually reviewed values on unrelated saves.</description>
    <interviewLabel>LOVING BuilderPO Derive From Lot {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING BuilderPO Derive From Lot</label>
    <processType>AutoLaunchedFlow</processType>
