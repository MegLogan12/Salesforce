    <description>Cascading account creator. Screen 1 is a 4-way record type chooser (Home Builder, Design and Build, Commercial, Land Development). Home Builder then cascades Parent Account, Division Account, or Community. Division asks for Parent lookup; Community asks for Division and auto-populates Parent.</description>
    <environments>Default</environments>
    <formulas>
        <name>FX_DivisionName</name>
        <dataType>String</dataType>
        <expression>{!FX_ShortParentName} &amp; &quot;: &quot; &amp; {!DV_Division}</expression>
    </formulas>
    <formulas>
        <name>FX_ShortParentName</name>
        <dataType>String</dataType>
        <expression>TRIM(
  SUBSTITUTE(
    SUBSTITUTE(
      SUBSTITUTE(
        SUBSTITUTE(
          SUBSTITUTE(
            SUBSTITUTE({!ParentAccountVar.Name}, &quot; Corporation&quot;, &quot;&quot;),
            &quot; Corp.&quot;, &quot;&quot;),
          &quot; Corp&quot;, &quot;&quot;),
        &quot; LLC&quot;, &quot;&quot;),
      &quot; Inc.&quot;, &quot;&quot;),
    &quot; Inc&quot;, &quot;&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>FX_SimpleRTDeveloperName</name>
        <dataType>String</dataType>
        <expression>CASE({!AccountTypePick},
  &quot;Design and Build&quot;, &quot;Design_and_Build&quot;,
  &quot;Commercial&quot;, &quot;Commercial&quot;,
  &quot;Land Development&quot;, &quot;Land_Development&quot;,
  &quot;&quot;)</expression>
    </formulas>
