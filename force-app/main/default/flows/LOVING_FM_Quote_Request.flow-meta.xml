    <description>FM captures new or changed scope in the field and routes it to Customer Success for pricing. Creates UMB_Quote_Request__c (Status: Submitted to Customer Success), creates Task for CS review, posts context from the active Work Order. FM cannot set price, GP, discount, or approve. Launched as Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fQR_TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Review quote request from FM on WO &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <formulas>
        <name>fTaskPriorityMapped</name>
        <dataType>String</dataType>
        <expression>IF({!Input_Urgency} = &quot;Immediate&quot;, &quot;High&quot;,
IF({!Input_Urgency} = &quot;Same week&quot;, &quot;High&quot;,
&quot;Normal&quot;))</expression>
    </formulas>
    <interviewLabel>LOVING FM Quote Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Quote Request</label>
