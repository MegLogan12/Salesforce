<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM flags the site as not ready for scheduling. Records reason, sets Site_Ready__c = Not Ready, creates Schedule Issue for the scheduling team. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Site NOT ready — block scheduling: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber}</expression>
    </formulas>
    <formulas>
        <name>fSI_Summary</name>
        <dataType>String</dataType>
        <expression>&quot;Site Not Ready — &quot; &amp; {!Input_Reason} &amp; &quot;. &quot; &amp; {!Input_Notes}</expression>
    </formulas>
    <interviewLabel>LOVING FM Flag Site Not Ready {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Flag Site Not Ready</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Schedule_Issue</name>
        <label>Create Schedule Issue</label>
        <locationX>176</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Create_Task</targetReference>
        </connector>
        <inputAssignments>
            <field>Standard_Work_Order__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Issue_Type__c</field>
            <value>
                <stringValue>Site Not Ready</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Summary__c</field>
            <value>
                <elementReference>fSI_Summary</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Severity__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_Manager__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Required_Action__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Schedule_Issue__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Task</name>
        <label>Notify Scheduling</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>fSI_Summary</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_FlagNotReady</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_WorkOrder_NotReady</name>
        <label>Flag Site Not Ready</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Create_Schedule_Issue</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Site_Ready__c</field>
            <value>
                <stringValue>Not Ready</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Site_Readiness_Status__c</field>
            <value>
                <stringValue>Fail</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Site_Not_Ready_Reason__c</field>
            <value>
                <elementReference>Input_Reason</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Site_Readiness_Notes__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <screens>
        <name>Screen_FlagNotReady</name>
        <label>Flag Site Not Ready</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_WorkOrder_NotReady</targetReference>
        </connector>
        <fields>
            <name>Display_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;Flag the site as not ready. This will block scheduling and create a Schedule Issue for the scheduling team to resolve.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_Reason</name>
            <choiceReferences>Choice_Access</choiceReferences>
            <choiceReferences>Choice_Utility</choiceReferences>
            <choiceReferences>Choice_Drainage</choiceReferences>
            <choiceReferences>Choice_Materials</choiceReferences>
            <choiceReferences>Choice_Grades</choiceReferences>
            <choiceReferences>Choice_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Reason Site Is Not Ready</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_Notes</name>
            <fieldText>Details (what needs to be resolved before scheduling)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>Site Flagged Not Ready</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Site flagged as Not Ready.&lt;/b&gt; Work Order {!Get_WorkOrder.WorkOrderNumber} is blocked from scheduling. A Schedule Issue has been created and the scheduling team has been notified.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Access</name>
        <choiceText>Site access blocked (gate, lock, no entry)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Site access blocked</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Utility</name>
        <choiceText>Utility markings not complete</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Utility markings not complete</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Drainage</name>
        <choiceText>Drainage / grading not complete</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Drainage / grading not complete</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Materials</name>
        <choiceText>Materials not delivered or incorrect</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Materials not delivered or incorrect</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Grades</name>
        <choiceText>Rough grades not accepted</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Rough grades not accepted</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Other</name>
        <choiceText>Other (explain in details)</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
