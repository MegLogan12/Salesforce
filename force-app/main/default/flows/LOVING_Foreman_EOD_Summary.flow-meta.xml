<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>End of day summary for foreman in FSL Mobile. Confirms 1-hour standard lunch deduction. Creates Rippling_Time_Entry__c deduction record. No dollar values shown. Activated 2026-05-30. Reactivated 2026-05-30.</description>
    <environments>Default</environments>
    <interviewLabel>LOVING Foreman EOD Summary {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Foreman EOD Summary</label>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Lunch_Deduction</name>
        <label>Create Lunch Deduction Time Entry</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <connector>
            <targetReference>Screen_EOD_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Employee__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Hours__c</field>
            <value>
                <numberValue>-1.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <elementReference>EODNotesInput</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_System__c</field>
            <value>
                <stringValue>Foreman Mobile EOD</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Work_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Rippling_Time_Entry__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Screen_EOD_Confirm</name>
        <label>Day Complete</label>
        <locationX>176</locationX>
        <locationY>528</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>EODConfirmText</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px; color: #04844b;&quot;&gt;✓ Day Complete / Día Completado&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Your end-of-day summary has been submitted. Great work today!&lt;/p&gt;&lt;p&gt;&lt;em&gt;Tu resumen de fin de día ha sido enviado. ¡Excelente trabajo hoy!&lt;/em&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_EOD_Lunch</name>
        <label>Lunch Deduction Confirmation</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Lunch_Deduction</targetReference>
        </connector>
        <fields>
            <name>LunchDeductionText</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Lunch Deduction / Deducción de Almuerzo&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;A standard 1-hour lunch deduction will be applied to today&apos;s time. This is required by company policy.&lt;/p&gt;&lt;p&gt;&lt;em&gt;Se aplicará una deducción estándar de 1 hora por almuerzo. Requerido por la política de la empresa.&lt;/em&gt;&lt;/p&gt;&lt;p&gt;Press Next to confirm. / Presiona Siguiente para confirmar.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_EOD_Summary</name>
        <label>End of Day — Summary</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Screen_EOD_Lunch</targetReference>
        </connector>
        <fields>
            <name>EODSummaryText</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;End of Day Summary / Resumen de Fin de Día&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Add any notes for your FM below.&lt;/p&gt;&lt;p&gt;&lt;em&gt;Agrega notas para tu FM a continuación.&lt;/em&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>EODNotesInput</name>
            <fieldText>End of day notes — anything your FM needs to know (optional) / Notas de fin de día para tu FM (opcional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Screen_EOD_Summary</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
