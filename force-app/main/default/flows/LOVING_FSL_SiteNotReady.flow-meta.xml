<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FSL Mobile Quick Action: Mark a Work Order site as not ready. Requires a reason. Sets Site_Ready_Overall__c false, Site_Not_Ready_Reason__c, and creates a Site_Readiness__c record with Status Blocked.</description>
    <interviewLabel>LOVING FSL Site Not Ready {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FSL — Site Not Ready</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>Flow</processType>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <choices>
        <name>choice_Grading</name>
        <choiceText>Grading not complete</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Grading not complete</stringValue></value>
    </choices>
    <choices>
        <name>choice_Access</name>
        <choiceText>Site not accessible</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Site not accessible</stringValue></value>
    </choices>
    <choices>
        <name>choice_Irrigation</name>
        <choiceText>Irrigation not roughed in</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Irrigation not roughed in</stringValue></value>
    </choices>
    <choices>
        <name>choice_Debris</name>
        <choiceText>Debris not cleared</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Debris not cleared</stringValue></value>
    </choices>
    <choices>
        <name>choice_BuilderPunch</name>
        <choiceText>Builder punch not cleared</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Builder punch not cleared</stringValue></value>
    </choices>
    <choices>
        <name>choice_Utilities</name>
        <choiceText>Utilities not cleared</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Utilities not cleared</stringValue></value>
    </choices>
    <choices>
        <name>choice_Other</name>
        <choiceText>Other — see notes</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Other</stringValue></value>
    </choices>

    <screens>
        <name>Screen_SiteNotReady</name>
        <label>Flag Site Not Ready</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Update_WorkOrder</targetReference></connector>
        <fields>
            <name>disp_Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Document why the site is not ready.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;A reason is required. This will block the work order from scheduling.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>inp_NotReadyReason</name>
            <choiceReferences>choice_Grading</choiceReferences>
            <choiceReferences>choice_Access</choiceReferences>
            <choiceReferences>choice_Irrigation</choiceReferences>
            <choiceReferences>choice_Debris</choiceReferences>
            <choiceReferences>choice_BuilderPunch</choiceReferences>
            <choiceReferences>choice_Utilities</choiceReferences>
            <choiceReferences>choice_Other</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Not Ready Reason</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>inp_Notes</name>
            <fieldText>Additional Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
    </screens>

    <recordUpdates>
        <name>Update_WorkOrder</name>
        <label>Update Work Order — Site Not Ready</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Site_Ready_Overall__c</field>
            <value><booleanValue>false</booleanValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Site_Readiness_Status__c</field>
            <value><stringValue>Not Ready</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Site_Not_Ready_Reason__c</field>
            <value><elementReference>inp_NotReadyReason</elementReference></value>
        </inputAssignments>
        <connector><targetReference>Create_SiteReadiness</targetReference></connector>
        <object>WorkOrder</object>
    </recordUpdates>

    <recordCreates>
        <name>Create_SiteReadiness</name>
        <label>Create Site Readiness Record</label>
        <locationX>400</locationX>
        <locationY>200</locationY>
        <inputAssignments>
            <field>Work_Order__c</field>
            <value><elementReference>recordId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Blocked</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Not_Ready_Reason__c</field>
            <value><elementReference>inp_NotReadyReason</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Field_Manager__c</field>
            <value><elementReference>$User.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>FM_Missing__c</field>
            <value><booleanValue>true</booleanValue></value>
        </inputAssignments>
        <object>Site_Readiness__c</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Screen_SiteNotReady</targetReference></connector>
    </start>
    <status>Active</status>
</Flow>
