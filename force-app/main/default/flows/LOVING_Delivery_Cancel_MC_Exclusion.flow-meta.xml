<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Check_Cancellation_Conditions</name>
        <label>Check Cancellation Conditions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Applicable</defaultConnectorLabel>
        <rules>
            <name>WO_Closed_Without_QC_With_Scope</name>
            <conditionLogic>(1 AND 2 AND 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delivery_QC_Complete__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sod_Square_Footage__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Mulch_CY__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_DQC</targetReference>
            </connector>
            <label>WO Closed Without QC With Scope</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_DQC_Found</name>
        <label>Check DQC Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No DQC Found</defaultConnectorLabel>
        <rules>
            <name>DQC_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_DQC</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Void_DQC_On_Cancellation</targetReference>
            </connector>
            <label>DQC Exists</label>
        </rules>
    </decisions>
    <description>When WorkOrder closes without a completed DQC and sod/mulch was in scope, flags the open DQC as voided. Prevents stale Pending DQC records from polluting FM dashboards. No MC, no Homeowner, no NDS workflow. INACTIVE — activate after PKG-05b-v3 and Meg approval.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCancellationNote</name>
        <dataType>String</dataType>
        <expression>&quot;Work Order closed without DQC completion (&quot; &amp; TEXT(NOW()) &amp; &quot;). DQC voided by system — delivery did not proceed or was not inspected. Prior notes: &quot; &amp; IF(ISBLANK({!Get_Open_DQC.Issue_Notes__c}), &quot;(none)&quot;, {!Get_Open_DQC.Issue_Notes__c})</expression>
    </formulas>
    <interviewLabel>LOVING Delivery Cancel MC Exclusion {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Delivery Cancel MC Exclusion</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_DQC</name>
        <label>Get Open DQC</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_DQC_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Work_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Issue_Flag__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Delivery_Quality_Check__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Issue_Notes__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Void_DQC_On_Cancellation</name>
        <label>Void DQC on Cancellation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Open_DQC.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Issue_Flag__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Issue_Notes__c</field>
            <value>
                <elementReference>fCancellationNote</elementReference>
            </value>
        </inputAssignments>
        <object>Delivery_Quality_Check__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Cancellation_Conditions</targetReference>
        </connector>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
