    <description>Screen flow for foreman 2PM health check response. Collects 7 health check answers. Updates WorkOrder job_health__c, red_flag_notes__c, Afternoon_Check_Complete__c, Last_Health_Check_At__c, FJ_Recommended__c. Creates Schedule_Issue__c (linked via Standard_WorkOrder__c) if any flag raised. Marks source Task completed. Requires pkg-closeout-05 deployed.</description>
    <formulas>
        <name>formula_FlagDetail</name>
        <dataType>String</dataType>
        <expression>IF({!var_OnTrack} = &quot;No&quot;, &quot;Not on track to finish today. &quot;, &quot;&quot;) &amp; IF({!var_OnTrack} = &quot;Partially&quot;, &quot;Partially on track to finish. &quot;, &quot;&quot;) &amp; IF({!var_MaterialShortage}, &quot;Material shortage — &quot; &amp; IF(ISBLANK({!var_MaterialNotes}), &quot;(no notes)&quot;, {!var_MaterialNotes}) &amp; &quot;. &quot;, &quot;&quot;) &amp; IF({!var_SiteIssue}, &quot;Site or access issue — &quot; &amp; IF(ISBLANK({!var_SiteNotes}), &quot;(no notes)&quot;, {!var_SiteNotes}) &amp; &quot;. &quot;, &quot;&quot;) &amp; IF({!var_LaborIssue}, &quot;Labor or crew issue — &quot; &amp; IF(ISBLANK({!var_LaborNotes}), &quot;(no notes)&quot;, {!var_LaborNotes}) &amp; &quot;. &quot;, &quot;&quot;) &amp; IF({!var_CustomerIssue}, &quot;Customer or builder issue — &quot; &amp; IF(ISBLANK({!var_CustomerNotes}), &quot;(no notes)&quot;, {!var_CustomerNotes}) &amp; &quot;. &quot;, &quot;&quot;) &amp; IF({!var_SafetyIssue}, &quot;SAFETY ISSUE — &quot; &amp; IF(ISBLANK({!var_SafetyNotes}), &quot;(no notes — FM must follow up)&quot;, {!var_SafetyNotes}) &amp; &quot;. &quot;, &quot;&quot;) &amp; IF({!var_FJRecommended}, &quot;Foreman recommends return visit (Finished Job). &quot;, &quot;&quot;) &amp; IF(NOT(ISBLANK({!var_AdditionalNotes})), &quot;Additional notes: &quot; &amp; {!var_AdditionalNotes}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_JobHealth</name>
        <dataType>String</dataType>
        <expression>IF({!var_SafetyIssue}, &quot;Red&quot;, IF({!var_MaterialShortage} || {!var_SiteIssue} || {!var_LaborIssue} || {!var_CustomerIssue} || {!var_OnTrack} &lt;&gt; &quot;Yes&quot;, &quot;Yellow&quot;, &quot;Green&quot;))</expression>
    </formulas>
    <formulas>
        <name>formula_RedFlagNotes</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!formula_FlagDetail}), &quot;No flags raised at 2PM check.&quot;, {!formula_FlagDetail})</expression>
    </formulas>
    <formulas>
        <name>formula_Severity</name>
        <dataType>String</dataType>
        <expression>IF({!var_SafetyIssue}, &quot;Critical&quot;, &quot;High&quot;)</expression>
    </formulas>
    <formulas>
        <name>formula_SummaryShort</name>
        <dataType>String</dataType>
        <expression>&quot;2PM Health Check — &quot; &amp; IF({!var_OnTrack} = &quot;No&quot;, &quot;Not on track; &quot;, &quot;&quot;) &amp; IF({!var_OnTrack} = &quot;Partially&quot;, &quot;Partial; &quot;, &quot;&quot;) &amp; IF({!var_MaterialShortage}, &quot;Material shortage; &quot;, &quot;&quot;) &amp; IF({!var_SiteIssue}, &quot;Site issue; &quot;, &quot;&quot;) &amp; IF({!var_LaborIssue}, &quot;Labor issue; &quot;, &quot;&quot;) &amp; IF({!var_CustomerIssue}, &quot;Customer issue; &quot;, &quot;&quot;) &amp; IF({!var_SafetyIssue}, &quot;SAFETY; &quot;, &quot;&quot;) &amp; IF({!var_FJRecommended}, &quot;FJ needed&quot;, &quot;&quot;)</expression>
    </formulas>
