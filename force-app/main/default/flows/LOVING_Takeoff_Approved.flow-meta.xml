    <decisions>
        <name>Check_Has_Package</name>
        <label>Has Active Community Package?</label>
        <locationX>176</locationX>
        <locationY>780</locationY>
        <defaultConnector>
            <targetReference>Create_Work_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Package — create WO without package</defaultConnectorLabel>
        <rules>
            <name>Has_Package</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCommunityPackageId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Community_Package</targetReference>
            </connector>
            <label>Has Package — look up Pricing Book</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_No_Existing_WO</name>
        <label>No Linked Standard WorkOrder Yet?</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <defaultConnectorLabel>WO already exists or PO bridge missing — skip</defaultConnectorLabel>
        <rules>
            <name>No_Existing_WO</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Linked_PO.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Linked_PO.Work_Order__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Community</targetReference>
            </connector>
            <label>No linked standard WorkOrder — proceed to create</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_Package</name>
        <label>Corner Lot — use Corner Package?</label>
        <locationX>176</locationX>
        <locationY>540</locationY>
        <defaultConnector>
            <targetReference>Assign_Standard_Package</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a corner lot — use Standard Package</defaultConnectorLabel>
        <rules>
            <name>Use_Corner_Package</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsCornerLot</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Corner_Package</targetReference>
            </connector>
            <label>Is corner lot — use Corner Package</label>
        </rules>
    </decisions>
    <description>On approved Takeoff, create and link the standard parent WorkOrder on the live Purchase_Order__c bridge. Duplicate guard prevents a second parent WorkOrder if the Purchase Order is already linked.</description>
    <interviewLabel>LOVING Takeoff Approved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Takeoff Approved</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
