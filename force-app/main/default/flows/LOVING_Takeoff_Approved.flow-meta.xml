                <elementReference>varCornerPkgId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Has_Package</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Standard_Package</name>
        <label>Resolved Package — Standard</label>
        <locationX>308</locationX>
        <locationY>660</locationY>
        <assignmentItems>
            <assignToReference>varCommunityPackageId</assignToReference>
            <operator>Assign</operator>
            <value>
