<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Check_811_Task_Exists</name>
        <label>811 Task already exists?</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>Task exists — end (no duplicate)</defaultConnectorLabel>
        <rules>
            <name>No_811_Task_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_811_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_811_Task</targetReference>
            </connector>
            <label>No 811 Task yet — create it</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Takeoff_Exists</name>
        <label>Takeoff already exists?</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_811_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Takeoff exists — skip to 811 Task</defaultConnectorLabel>
        <rules>
            <name>No_Takeoff_Yet</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Takeoff</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Takeoff</targetReference>
            </connector>
            <label>No Takeoff yet — create it</label>
        </rules>
    </decisions>
    <description>After-save on Builder_PO__c Update: fires when Pipeline_Stage__c changes to &quot;31 Days&quot;. Creates a Takeoff (if one does not already exist for this PO) AND an 811 utility locate Task (if one does not already exist for this Lot). Both have independent duplicate guards so neither creation blocks the other. This fixes the original design where the 811 Task was gated inside the Takeoff duplicate guard — meaning if LOVING_Create_Takeoff_From_PO had already created the Takeoff, the 811 Task was silently skipped.</description>
    <interviewLabel>LOVING Create Takeoff And 811 Tasks {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Create Takeoff And 811 Tasks</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_811_Task</name>
        <label>Create 811 Utility Locate Task</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <faultConnector>
            <targetReference>Log_Flow_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Record.Requested_Install_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Submit 811 utility locate request for this lot. Required before any digging or installation. Confirm locate completion and update Lot Eight11_Task_Status__c field.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>811 Utility Locate Required — 30-Day Gate</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Lot__c</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordCreates>
        <name>Create_Takeoff</name>
        <label>Create Takeoff</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <connector>
            <targetReference>Get_Existing_811_Task</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Flow_Fault</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Builder_PO__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Community__c</field>
            <value>
                <elementReference>$Record.Community__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lot__c</field>
            <value>
                <elementReference>$Record.Lot__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Takeoff__c</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Flow_Fault</name>
        <label>Log Flow Fault</label>
        <locationX>440</locationX>
        <locationY>720</locationY>
        <inputAssignments>
            <field>Class_Name__c</field>
            <value>
                <stringValue>LOVING_Create_Takeoff_And_811_Tasks</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Logged_At__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Method_Name__c</field>
            <value>
                <stringValue>Create_Takeoff_or_811_Task</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Record_Id__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>User__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Error_Log__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_811_Task</name>
        <label>Get Existing 811 Task for This Lot</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_811_Task_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Lot__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>811 Utility Locate Required — 30-Day Gate</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Takeoff</name>
        <label>Get Existing Takeoff for This PO</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Takeoff_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Builder_PO__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Takeoff__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Existing_Takeoff</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Pipeline_Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>31 Days</stringValue>
            </value>
        </filters>
        <filters>
            <field>Lot__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Builder_PO__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
