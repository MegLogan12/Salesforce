<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FM approves closeout of a completed work order. Confirms quantities, attaches photo proof, and submits for final review. Sets Foreman_Submit_Status to Submitted and notifies the operations team. Launched as a Quick Action from WorkOrder.</description>
    <environments>Default</environments>
    <formulas>
        <name>fTodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>fNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>fTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Closeout submitted for review: &quot; &amp; {!Get_WorkOrder.WorkOrderNumber} &amp; &quot; — &quot; &amp; {!Get_WorkOrder.Subject}</expression>
    </formulas>
    <interviewLabel>LOVING FM Approve Closeout {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FM Approve Closeout</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Task</name>
        <label>Notify Operations — Closeout Ready</label>
        <locationX>176</locationX>
        <locationY>504</locationY>
        <connector>
            <targetReference>Screen_Confirm</targetReference>
        </connector>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_WorkOrder</name>
        <label>Get Work Order</label>
        <locationX>176</locationX>
        <locationY>72</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_Closeout</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>WorkOrder</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>WorkOrderNumber</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>QI_Complete__c</queriedFields>
        <queriedFields>QI_Result__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_WorkOrder_Closeout</name>
        <label>Save Closeout to Work Order</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Create_Task</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Foreman_Submit_Status__c</field>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Foreman_Submit_At__c</field>
            <value>
                <elementReference>fNow</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Submitted_Date__c</field>
            <value>
                <elementReference>fTodayDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Quantities_Confirmed__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Closeout_Notes__c</field>
            <value>
                <elementReference>Input_Notes</elementReference>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>
    <screens>
        <name>Screen_Closeout</name>
        <label>Approve Closeout</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Update_WorkOrder_Closeout</targetReference>
        </connector>
        <fields>
            <name>Display_Context</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Work Order:&lt;/b&gt; {!Get_WorkOrder.WorkOrderNumber} — {!Get_WorkOrder.Subject}&lt;/p&gt;
&lt;p&gt;Submit final closeout. Confirm that all quantities have been verified, photos have been attached, and the job site is clean and complete. The operations team will review and close the work order.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Input_QuantitiesConfirmed</name>
            <dataType>Boolean</dataType>
            <fieldText>I confirm all installed quantities match the work order scope</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_PhotosAttached</name>
            <dataType>Boolean</dataType>
            <fieldText>I confirm completion photos have been attached to this work order</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Input_Notes</name>
            <fieldText>Closeout Notes (punchlist items, open items, anything ops needs to know)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Confirm</name>
        <label>Closeout Submitted</label>
        <locationX>176</locationX>
        <locationY>612</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Confirm</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Closeout submitted.&lt;/b&gt; Work Order {!Get_WorkOrder.WorkOrderNumber} has been submitted for final review. The operations team has been notified.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
