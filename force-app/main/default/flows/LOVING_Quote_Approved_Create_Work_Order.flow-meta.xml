<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Check_No_Existing_WO</name>
        <label>Check No Existing Work Order</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Create_Work_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Work Order Yet</defaultConnectorLabel>
        <rules>
            <name>WO_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Standard_Work_Order__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Work Order Already Exists</label>
        </rules>
    </decisions>
    <description>When a Quote is approved (Status = Approved), create a standard Field Service WorkOrder linked to the quote.</description>
    <interviewLabel>LOVING Quote Approved Create Work Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Quote Approved Create Work Order</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Work_Order</name>
        <label>Create Work Order</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <connector>
            <targetReference>Link_WO_To_Quote</targetReference>
        </connector>
        <inputAssignments>
            <field>Builder_PO__c</field>
            <value>
                <elementReference>$Record.Builder_PO__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Community_FML__c</field>
            <value>
                <elementReference>$Record.Community__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lot__c</field>
            <value>
                <elementReference>$Record.Lot__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Pending Takeoff</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Takeoff__c</field>
            <value>
                <elementReference>$Record.Takeoff__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Work_Order_Type__c</field>
            <value>
                <stringValue>Production Install</stringValue>
            </value>
        </inputAssignments>
        <object>WorkOrder</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Link_WO_To_Quote</name>
        <label>Link Work Order to Quote</label>
        <locationX>176</locationX>
        <locationY>638</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Standard_Work_Order__c</field>
            <value>
                <elementReference>Create_Work_Order</elementReference>
            </value>
        </inputAssignments>
        <object>Quote__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_No_Existing_WO</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>Quote__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
