<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>FSL Mobile Quick Action: Flag a Work Order with a red flag issue. Requires notes. Sets Red_Flag_Notes__c and Red_Flag_Timestamp__c.</description>
    <interviewLabel>LOVING FSL Red Flag {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING FSL — Red Flag</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>Flow</processType>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>

    <formulas>
        <name>fNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>

    <screens>
        <name>Screen_RedFlag</name>
        <label>Flag Red Flag Issue</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector><targetReference>Update_WorkOrder</targetReference></connector>
        <fields>
            <name>disp_Header</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Document the red flag issue.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;This will set the work order to Red Hold status and timestamp the flag. Notes are required.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>inp_RedFlagNotes</name>
            <fieldText>Red Flag Notes</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
        </fields>
    </screens>

    <recordUpdates>
        <name>Update_WorkOrder</name>
        <label>Update Work Order — Red Flag</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>Red_Flag_Notes__c</field>
            <value><elementReference>inp_RedFlagNotes</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Red_Flag_Timestamp__c</field>
            <value><elementReference>fNow</elementReference></value>
        </inputAssignments>
        <object>WorkOrder</object>
    </recordUpdates>

    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Screen_RedFlag</targetReference></connector>
    </start>
    <status>Active</status>
</Flow>
