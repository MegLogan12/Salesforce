<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>When the Aqua Watering Schedule Run_Time_Pct changes, update all open Aqua Check Tickets for the same community to reflect the new run time percentage.</description>
    <interviewLabel>LOVING Aqua Watering Schedule Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LOVING Aqua Watering Schedule Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Check_Tickets</name>
        <label>Update Open Check Tickets Run Time</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Community__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Community__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Watering_Instructions__c</field>
            <value>
                <elementReference>$Record.Run_Time_Pct__c</elementReference>
            </value>
        </inputAssignments>
        <object>Aqua_Check_Ticket__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Check_Tickets</targetReference>
        </connector>
        <object>Aqua_Watering_Schedule__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
