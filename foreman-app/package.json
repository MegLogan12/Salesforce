{
  "name": "loving-field",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 npx expo start --web --port 3000",
    "start": "EXPO_NO_TELEMETRY=1 npx expo start",
    "start:ios": "EXPO_NO_TELEMETRY=1 npx expo start --ios",
    "start:android": "EXPO_NO_TELEMETRY=1 npx expo start --android",
    "start:tunnel": "EXPO_NO_TELEMETRY=1 npx expo start --tunnel",
    "build:web": "EXPO_NO_TELEMETRY=1 npx expo export --platform web",
    "build:ios": "EXPO_NO_TELEMETRY=1 eas build --platform ios",
    "build:android": "EXPO_NO_TELEMETRY=1 eas build --platform android",
    "prebuild": "EXPO_NO_TELEMETRY=1 npx expo prebuild",
    "prebuild:clean": "EXPO_NO_TELEMETRY=1 npx expo prebuild --clean",
    "doctor": "EXPO_NO_TELEMETRY=1 npx expo doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@tanstack/react-query": "^5.90.0",
    "ajv": "^8.20.0",
    "expo": "~53.0.27",
    "expo-auth-session": "~5.5.2",
    "expo-av": "~15.1.7",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~55.0.15",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~1.12.15",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-location": "~18.1.5",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.22.1",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "~4.14.1",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~18.3.12",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  }
