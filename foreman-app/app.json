{
  "expo": {
    "name": "LOVING Field",
    "slug": "loving-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lovingfield",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1f3c"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lovingcompanies.foreman",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take before and after job site photos",
        "NSPhotoLibraryUsageDescription": "Save job site photos",
        "NSLocationWhenInUseUsageDescription": "Navigate to job sites"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0d1f3c"
      },
      "package": "com.lovingcompanies.foreman",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      ["expo-image-picker", {
        "photosPermission": "Save job site photos",
        "cameraPermission": "Take before and after job site photos"
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "Navigate to job sites"
      }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "loving-fm-mobile-hh3bhj9z" }
    }
  }
}
