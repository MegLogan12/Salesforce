#!/usr/bin/env bash
# LOVING SF Deploy CLI
# Usage: ./loving-sf <command> [options]

set -euo pipefail

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

# ── Defaults ──────────────────────────────────────────────────────────────────
SANDBOX_ALIAS="loving-sandbox"
PROD_ALIAS="loving-prod"
SOURCE_DIR="force-app"
TEST_CLASS="LOVING_WorkOrderTriggerHandlerTest"

# ── Helpers ───────────────────────────────────────────────────────────────────
info()    { echo -e "${CYAN}→${RESET} $*"; }
success() { echo -e "${GREEN}✓${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET}  $*"; }
die()     { echo -e "${RED}✗${RESET}  $*" >&2; exit 1; }

require_sf() {
  command -v sf &>/dev/null || die "'sf' CLI not found. Install: https://developer.salesforce.com/tools/salesforcecli"
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_auth() {
  local target="${1:-sandbox}"
  require_sf
  case "$target" in
    sandbox)
      info "Authenticating to sandbox (alias: $SANDBOX_ALIAS)…"
      sf auth web login --alias "$SANDBOX_ALIAS" --instance-url https://test.salesforce.com
      success "Sandbox authenticated as '$SANDBOX_ALIAS'"
      ;;
    prod)
      info "Authenticating to production (alias: $PROD_ALIAS)…"
      sf auth web login --alias "$PROD_ALIAS"
      success "Production authenticated as '$PROD_ALIAS'"
      ;;
    *)
      die "Unknown target '$target'. Use: sandbox | prod"
      ;;
  esac
}

cmd_validate() {
  require_sf
  info "Validating against sandbox (dry run)…"
  sf project deploy validate \
    --source-dir "$SOURCE_DIR" \
    --target-org "$SANDBOX_ALIAS" \
    --test-level RunSpecifiedTests \
    --tests "$TEST_CLASS"
  success "Validation passed — no changes deployed"
}

cmd_deploy() {
  local target="${1:-sandbox}"
  require_sf
  case "$target" in
    sandbox)
      info "Deploying to sandbox ($SANDBOX_ALIAS)…"
      sf project deploy start \
        --source-dir "$SOURCE_DIR" \
        --target-org "$SANDBOX_ALIAS" \
        --test-level RunSpecifiedTests \
        --tests "$TEST_CLASS"
      success "Deployed to sandbox"
      ;;
    prod)
      warn "Deploying to PRODUCTION ($PROD_ALIAS). Continue? [y/N] "
      read -r confirm
      [[ "$confirm" =~ ^[Yy]$ ]] || { info "Aborted."; exit 0; }
      sf project deploy start \
        --source-dir "$SOURCE_DIR" \
        --target-org "$PROD_ALIAS" \
        --test-level RunSpecifiedTests \
        --tests "$TEST_CLASS"
      success "Deployed to production"
      ;;
    *)
      die "Unknown target '$target'. Use: sandbox | prod"
      ;;
  esac
}

cmd_test() {
  local org="${1:-$SANDBOX_ALIAS}"
  require_sf
  info "Running $TEST_CLASS against $org…"
  sf apex run test \
    --class-names "$TEST_CLASS" \
    --target-org "$org" \
    --result-format human \
    --wait 10
}

cmd_schedule() {
  echo -e "\n${BOLD}Paste this block into Developer Console → Execute Anonymous:${RESET}\n"
  cat <<'APEX'
// 1. Bucket Engine — daily 5:00 AM
System.schedule('LOVING Bucket Engine 5AM',       '0 0 5  ? * * *',       new LOVING_BucketEngineScheduler());
// 2. Health Check Prompt — weekdays 2:00 PM
System.schedule('LOVING Health Check 2PM',         '0 0 14 ? * MON-FRI *', new LOVING_HealthCheckScheduler());
// 3. Health Check Escalation — weekdays 3:00 PM
System.schedule('LOVING Health Check Escalation 3PM','0 0 15 ? * MON-FRI *',new LOVING_HealthCheckEscalationScheduler());
// 4. Takeoff Escalation — weekdays 9:00 AM
System.schedule('LOVING Takeoff Escalation 9AM',   '0 0 9  ? * MON-FRI *', new LOVING_TakeoffEscalationScheduler());
// 5. QI Escalation — weekdays 8:00 AM
System.schedule('LOVING QI Escalation 8AM',        '0 0 8  ? * MON-FRI *', new LOVING_QIEscalationScheduler());
APEX
  echo -e "\nThen verify: Setup → Scheduled Jobs (expect 5 jobs)."
}

cmd_checklist() {
  echo -e "\n${BOLD}Post-Deploy Checklist${RESET}\n"
  echo "  [ ] 5 Apex scheduled jobs visible in Setup → Scheduled Jobs"
  echo "  [ ] LOVING_PI_Orchestrator flow → Active"
  echo "  [ ] LOVING_Takeoff_To_WO_Creation flow → Active"
  echo "  [ ] LOVING_Bucket_Engine flow → Active"
  echo "  [ ] LOVING_Health_Check_Daily flow → Active"
  echo "  [ ] LOVING_Takeoff_Escalation flow → Active"
  echo "  [ ] All 6 LOVING_PI_* sub-flows → Active"
  echo "  [ ] FSL Operating Hours created (Mon-Fri 6:30 AM – 5:00 PM ET)"
  echo "  [ ] Service Territory: Charlotte Metro"
  echo "  [ ] WorkOrder Status picklist values added (see README)"
  echo "  [ ] Account Record Types created (Builder_National, Builder_Regional, Community, Lot)"
  echo "  [ ] Celigo recipe pointing to WorkOrder (not Opportunity)"
}

cmd_orgs() {
  require_sf
  sf org list
}

cmd_help() {
  echo -e "${BOLD}LOVING SF Deploy CLI${RESET}"
  echo ""
  echo -e "${BOLD}Usage:${RESET}  ./loving-sf <command> [args]"
  echo ""
  echo -e "${BOLD}Commands:${RESET}"
  echo "  auth [sandbox|prod]     Authenticate to sandbox (default) or production"
  echo "  validate                Dry-run deploy validation against sandbox"
  echo "  deploy [sandbox|prod]   Deploy to sandbox (default) or production"
  echo "  test [alias]            Run Apex tests (default: $SANDBOX_ALIAS)"
  echo "  schedule                Print Apex scheduler block for Developer Console"
  echo "  checklist               Show post-deploy verification checklist"
  echo "  orgs                    List authenticated orgs"
  echo "  help                    Show this help"
  echo ""
  echo -e "${BOLD}Examples:${RESET}"
  echo "  ./loving-sf auth sandbox"
  echo "  ./loving-sf validate"
  echo "  ./loving-sf deploy sandbox"
  echo "  ./loving-sf test"
  echo "  ./loving-sf deploy prod"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
  auth)      cmd_auth "$@" ;;
  validate)  cmd_validate ;;
  deploy)    cmd_deploy "$@" ;;
  test)      cmd_test "$@" ;;
  schedule)  cmd_schedule ;;
  checklist) cmd_checklist ;;
  orgs)      cmd_orgs ;;
  help|--help|-h) cmd_help ;;
  *) die "Unknown command '$CMD'. Run './loving-sf help' for usage." ;;
esac
