# LOVING Field Manager — environment variables
# Copy to .env.local for local development. Never commit .env.local.

# ─── Option A: Debug token (dev/CI only) ─────────────────────────────────────
# Paste a valid access token from Salesforce Developer Console → Execute Anonymous:
#   System.debug(UserInfo.getSessionId());
# This bypasses OAuth and is NOT safe for production.

VITE_SF_INSTANCE_URL=https://your-org.my.salesforce.com
VITE_SF_ACCESS_TOKEN=your_access_token_here
VITE_SF_USER_ID=005xxxxxxxxxxxxxxx
VITE_SF_ORG_ID=00Dxxxxxxxxxxxxxxx
VITE_SF_USERNAME=jordan.ellis@yourorg.com

# ─── Option B: OAuth2 PKCE (production) ──────────────────────────────────────
# Create a Connected App in Salesforce Setup → App Manager:
#   - Enable OAuth settings
#   - Callback URL: http://localhost:5173/oauth/callback (dev)
#                   https://your-app-domain.com/oauth/callback (prod)
#   - Selected Scopes: api, refresh_token
#   - Require PKCE: checked
# Then paste the Consumer Key below.

VITE_SF_INSTANCE_URL=https://your-org.my.salesforce.com
VITE_SF_CLIENT_ID=3MVG9...your_consumer_key...
VITE_SF_REDIRECT_URI=http://localhost:5173/oauth/callback

# ─── Field Manager user setup ────────────────────────────────────────────────
# The app queries: WorkOrder WHERE FM__c = <logged-in user ID>
# Ensure the test FM user is assigned as FM__c on at least one open WorkOrder.
# The permission set LOVING_Field_Manager_App_User must be assigned to the user.
